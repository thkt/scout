{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>thkt/renovate-config"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Cargo\\.toml$/"],
      "matchStrings": ["rust-version\\s*=\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rust",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["rust"],
      "addLabels": ["dependencies", "rust"],
      "commitMessageTopic": "rust-version (MSRV)"
    },
    {
      "description": "Review HTML extraction, DOM, and parser dependency updates together.",
      "matchManagers": ["cargo"],
      "matchDepNames": ["dom_smoothie", "dom_query", "html5ever"],
      "groupName": "HTML extraction + DOM parser"
    }
  ]
}
